data/processed/**
!data/processed/.gitkeep
data/indexes/**
!data/indexes/.gitkeep
data/models/**
!data/models/.gitkeep
data/cache/**
!data/cache/.gitkeep

# Editors and operating system
.vscode/
.idea/
Thumbs.db
Desktop.ini
