# Optional override for the active journal configuration.
# Use a path relative to the Project folder, or an absolute path.
# JOURNAL_ASSISTANT_CONFIG=config/journals/indian_pediatrics.toml

# Add API keys only as environment variables on your computer when a later step needs them.
# Do not put real secrets in this file or commit them to Git.

# API calls send the question and selected text passages to the configured answer provider.
# Embeddings are generated locally with FastEmbed; the model downloads once from its model host.
# Keep false until the project owner has reviewed and explicitly approved the answer-provider data flow.
JOURNAL_ASSISTANT_ALLOW_EXTERNAL_TEXT_PROCESSING=false
# GROQ_API_KEY=
